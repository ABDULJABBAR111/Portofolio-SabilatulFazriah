# Salin menjadi .env.local (lokal) dan isi juga di Vercel > Project Settings > Environment Variables
# JANGAN pernah memberi prefix NEXT_PUBLIC_ pada key ini & jangan commit file .env.local
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=ISI_SERVICE_ROLE_KEY_DARI_SUPABASE
# string acak panjang (untuk hash IP), contoh: openssl rand -hex 32
IP_HASH_SALT=ganti-dengan-string-acak-panjang
